extends SceneTree
func _initialize() -> void: _run.call_deferred()
func _run() -> void:
	var link = load("res://test/admin_link_fixture.gd").new()
	root.add_child(link)
	link.store = load("res://src/sim/world_store.gd").new()
	var directory := OS.get_environment("LONGWALK_TEST_DATA")
	assert(directory!="", "Test runner must provide isolated data directory")
	var state: Dictionary = link.store.initialize(directory,link.version)
	link.world = load("res://src/sim/shared_world.gd").new()
	link.world.initialize(JSON.parse_string(FileAccess.get_file_as_string("res://world/baseline.json")),state)
	link.admin = load("res://src/admin/admin_control.gd").new()
	assert(link.admin.initialize(link,directory))
	var control = link.admin
	assert(control.create_account("test-admin","a".repeat(32),"b".repeat(64)), control.storage_error)
	var principal := {"name":"test-admin","role":"admin"}
	var moderator := {"name":"test-mod","role":"mod"}
	link.world.data.players["a".repeat(64)]={"position":[0,0,9]}
	link.world.WORK.ensure(link.world.data.players["a".repeat(64)])
	assert(not control.execute({},"pause",{"paused":true}).ok)
	assert(not control.execute(moderator,"skill",{"player":"a".repeat(64),"skill":"running","level":5,"confirmed":true}).ok)
	assert(not control.execute(principal,"skill",{"player":"a".repeat(64),"skill":"running","level":5}).ok)
	assert(control.execute(principal,"skill",{"player":"a".repeat(64),"skill":"running","level":5,"confirmed":true}).ok)
	assert(link.world.data.players["a".repeat(64)].practice.running==2500)
	assert(not control.execute(principal,"skill",{"player":"a".repeat(64),"skill":"running","level":NAN,"confirmed":true}).ok)
	assert(control.execute(moderator,"inspect",{"player":"a".repeat(64)}).ok)
	assert(not control.execute(moderator,"teleport_self",{"confirmed":true,"x":0,"z":9}).ok)
	link.connections[42]="a".repeat(64)
	var ticket: Dictionary=control.execute(principal,"ticket",{"player":"a".repeat(64),"role":"mod"})
	assert(ticket.ok)
	assert(control.redeem(42,ticket.code).ok)
	assert(not control.redeem(42,ticket.code).ok)
	assert(control.staff_for(42).role=="mod")
	assert(not control.execute(principal,"ticket",{"player":"a".repeat(64),"role":"admin"},42).ok)
	assert(not control.execute(principal,"release_settings",{"confirmed":true},42).ok)
	assert(control.execute(moderator,"teleport_self",{"confirmed":true,"x":0,"z":9,"area":"outside"},42).ok)
	assert(not control.execute(moderator,"teleport",{"player":"a".repeat(64),"confirmed":true,"x":0,"z":9}).ok)
	assert(not control.execute(moderator,"teleport_self",{"confirmed":true,"x":999,"z":9},42).ok)
	assert(control.execute(principal,"revoke",{"player":"a".repeat(64),"confirmed":true}).ok)
	assert(control.staff_for(42).is_empty())
	link.connections.clear()
	assert(control.execute(principal,"pause",{"paused":true}).ok)
	assert(control.execute(principal,"pause",{"paused":true}).ok and link.world.data.paused)
	assert(control.execute(principal,"backup",{}).ok)
	var backup: String=link.store.records("backup-")[0]
	assert(control.execute(principal,"restore",{"name":backup,"confirmed":true}).ok)
	assert(link.world.data.paused)
	assert(control.audit_tail.size()>0)
	print("ADMIN RULES PASSED: permissions, confirmation, skills, one-use grants, revocation and recovery")
	quit()
